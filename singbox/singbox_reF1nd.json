      {"tag": "global_non_ip", "type": "remote", "format": "source", "url": "https://ruleset.skk.moe/sing-box/non_ip/global.json"},
      {"tag": "geosite-!cn", "type": "remote", "format": "binary", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/geolocation-!cn.srs"},
      
      {"tag": "domestic_ip", "type": "remote", "format": "source", "url": "https://ruleset.skk.moe/sing-box/ip/domestic.json"},
      {"tag": "china_ip", "type": "remote", "format": "source", "url": "https://ruleset.skk.moe/sing-box/ip/china_ip.json"},
      
      {"tag": "geosite-cn", "type": "remote", "format": "binary", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/cn.srs"},
      {"tag": "geoip-cn", "type": "remote", "format": "binary", "url": "https://gh-proxy.com/https://github.com/qljsyph/ruleset-icon/raw/refs/heads/main/sing-box/geoip/China-ASN-combined-ip.srs"}
    ],
    "final": "🐟 Fallback",
    "default_http_client": "s-download",
    "auto_detect_interface": true,
    "default_domain_resolver": {"server": "dns-direct"}
  },
  "outbounds": [
    {"tag": "🪁 Nodes", "type": "selector", "outbounds": ["🇭🇰 Hong Kong", "🇭🇰 Direct Hong Kong", "🇸🇬 Singapore", "🇨🇳 Taiwan", "🇯🇵 Japan", "🇰🇷 Korea", "🇺🇸 USA", "💠 Backup", "✋ Manual", "🎯 Direct"]},
    {"tag": "💾 Download", "type": "selector", "outbounds": ["🎯 Direct", "🪁 Nodes", "🇭🇰 Hong Kong", "🇭🇰 Direct Hong Kong", "🇸🇬 Singapore", "🇨🇳 Taiwan", "🇯🇵 Japan", "🇰🇷 Korea", "🇺🇸 USA", "💠 Backup", "✋ Manual"]},
    {"tag": "💬 Telegram", "type": "selector", "outbounds": ["🇸🇬 Singapore", "🇭🇰 Hong Kong", "🇭🇰 Direct Hong Kong", "🇯🇵 Japan", "🇺🇸 USA", "🪁 Nodes", "💠 Backup", "✋ Manual"]},
    {"tag": "🎼 Spotify", "type": "selector", "outbounds": ["🪁 Nodes", "🇭🇰 Hong Kong", "🇭🇰 Direct Hong Kong", "🇸🇬 Singapore", "🇨🇳 Taiwan", "🇯🇵 Japan", "🇰🇷 Korea", "🇺🇸 USA", "🇹🇷 Turkey", "🇺🇳 Others", "💠 Backup", "✋ Manual"]},
    {"tag": "🎮 Gaming", "type": "selector", "outbounds": ["🎯 Direct", "🪁 Nodes", "🇭🇰 Hong Kong", "🇭🇰 Direct Hong Kong", "🇸🇬 Singapore", "🇨🇳 Taiwan", "🇯🇵 Japan", "🇰🇷 Korea", "🇺🇸 USA", "🇹🇷 Turkey", "🇺🇳 Others", "💠 Backup", "✋ Manual"]},
    {"tag": "📹 Global Media", "type": "selector", "outbounds": ["🪁 Nodes", "🇭🇰 Hong Kong", "🇭🇰 Direct Hong Kong", "🇸🇬 Singapore", "🇨🇳 Taiwan", "🇯🇵 Japan", "🇰🇷 Korea", "🇺🇸 USA", "💠 Backup", "✋ Manual"]},
    {"tag": "📹 HK&TW Media", "type": "selector", "outbounds": ["🎯 Direct", "🪁 Nodes", "🇭🇰 Hong Kong", "🇭🇰 Direct Hong Kong", "🇸🇬 Singapore", "🇨🇳 Taiwan", "🇯🇵 Japan", "🇰🇷 Korea", "🇺🇸 USA", "💠 Backup", "✋ Manual"]},
    {"tag": "🎥 Emby", "type": "selector", "outbounds": ["🪁 Nodes", "🇭🇰 Hong Kong", "🇭🇰 Direct Hong Kong", "🇸🇬 Singapore", "🇨🇳 Taiwan", "🇯🇵 Japan", "🇰🇷 Korea", "🇺🇸 USA", "💠 Backup", "✋ Manual"]},
    {"tag": "🤖 AIGC", "type": "selector", "outbounds": ["🇺🇸 USA", "🇭🇰 Hong Kong", "🇭🇰 Direct Hong Kong", "🇸🇬 Singapore", "🇨🇳 Taiwan", "🇯🇵 Japan", "🇰🇷 Korea", "🇪🇺 Europe", "💠 Backup"]},
    {"tag": "💾 Microsoft", "type": "selector", "outbounds": ["🎯 Direct", "🪁 Nodes", "🇭🇰 Hong Kong", "🇭🇰 Direct Hong Kong", "🇸🇬 Singapore", "🇨🇳 Taiwan", "🇯🇵 Japan", "🇰🇷 Korea", "🇺🇸 USA", "💠 Backup", "✋ Manual"]},
    {"tag": "🍎 Apple", "type": "selector", "outbounds": ["🎯 Direct", "🇭🇰 Hong Kong", "🇭🇰 Direct Hong Kong", "🇸🇬 Singapore", "🇨🇳 Taiwan", "🇯🇵 Japan", "🇰🇷 Korea", "🇺🇸 USA", "💠 Backup"]},
    {"tag": "🐟 Fallback", "type": "selector", "outbounds": ["🪁 Nodes", "🇭🇰 Hong Kong", "🇭🇰 Direct Hong Kong", "🇸🇬 Singapore", "🇨🇳 Taiwan", "🇯🇵 Japan", "🇰🇷 Korea", "🇺🇸 USA", "💠 Backup", "🎯 Direct"]},
    
    {"tag": "✋ Manual", "type": "selector", "outbounds": [], "use_all_providers": true},
    {"tag": "🇭🇰 Hong Kong", "type": "urltest", "outbounds": [], "use_all_providers": true, "include": "(?i)(🇭🇰|港|\\bHK\\b|\\bHKG\\b|Hong)", "exclude": "(?i)(备用|「P」|「L」|x0\\.01|x0\\.8)", "url": "http://cp.cloudflare.com", "interval": "5m", "tolerance": 20},
    {"tag": "🇭🇰 Direct Hong Kong", "type": "urltest", "outbounds": [], "use_all_providers": true, "include": "(?i)(「P」|「L」).*(🇭🇰|港|\\bHK\\b|\\bHKG\\b|Hong)", "exclude": "(?i)备用", "url": "http://cp.cloudflare.com", "interval": "5m", "tolerance": 20},
    {"tag": "🇸🇬 Singapore", "type": "urltest", "outbounds": [], "use_all_providers": true, "include": "(?i)(🇸🇬|新加坡|\\bSG\\b|Singapore)", "exclude": "(?i)(x0\\.01|x0\\.8)", "url": "http://cp.cloudflare.com", "interval": "5m", "tolerance": 20},
    {"tag": "🇨🇳 Taiwan", "type": "urltest", "outbounds": [], "use_all_providers": true, "include": "(?i)(🇨🇳|台|\\bTW\\b|Taiwan)", "exclude": "(?i)(x0\\.01|x0\\.8)", "url": "http://cp.cloudflare.com", "interval": "5m", "tolerance": 20},
    {"tag": "🇯🇵 Japan", "type": "urltest", "outbounds": [], "use_all_providers": true, "include": "(?i)(🇯🇵|日本|\\bJP\\b|Japan)", "exclude": "(?i)(x0\\.01|x0\\.8)", "url": "http://cp.cloudflare.com", "interval": "5m", "tolerance": 20},
    {"tag": "🇰🇷 Korea", "type": "urltest", "outbounds": [], "use_all_providers": true, "include": "(?i)(🇰🇷|韩国|\\bKR\\b|Korea)", "url": "http://cp.cloudflare.com", "interval": "5m", "tolerance": 20},
    {"tag": "🇺🇸 USA", "type": "urltest", "outbounds": [], "use_all_providers": true, "include": "(?i)(🇺🇸|美|\\bUSA?\\b|United\\sStates)", "exclude": "(?i)(x0\\.01|x0\\.8)", "url": "http://cp.cloudflare.com", "interval": "5m", "tolerance": 20},
    {"tag": "🇪🇺 Europe", "type": "selector", "outbounds": [], "use_all_providers": true, "include": "(?i)(🇩🇪|德国|\\bDE\\b|Germany|🇫🇷|法国|\\bFR\\b|France|🇮🇹|意大利|\\bIT\\b|Italy|🇪🇸|西班牙|\\bES\\b|Spain|🇬🇧|英国|\\bUK\\b|United\\sKingdom)"},
