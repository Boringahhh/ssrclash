      {"tag": "apple_cdn", "type": "remote", "format": "source", "url": "https://ruleset.skk.moe/sing-box/domainset/apple_cdn.json"},
      {"tag": "apple_services", "type": "remote", "format": "source", "url": "https://ruleset.skk.moe/sing-box/non_ip/apple_services.json"},
      {"tag": "apple_cn_non_ip", "type": "remote", "format": "source", "url": "https://ruleset.skk.moe/sing-box/non_ip/apple_cn.json"},
      
      {"tag": "microsoft_cdn_non_ip", "type": "remote", "format": "source", "url": "https://ruleset.skk.moe/sing-box/non_ip/microsoft_cdn.json"},
      {"tag": "microsoft_non_ip", "type": "remote", "format": "source", "url": "https://ruleset.skk.moe/sing-box/non_ip/microsoft.json"},
      
      {"tag": "download_domainset", "type": "remote", "format": "source", "url": "https://ruleset.skk.moe/sing-box/domainset/download.json"},
      {"tag": "download_non_ip", "type": "remote", "format": "source", "url": "https://ruleset.skk.moe/sing-box/non_ip/download.json"},
      
      {"tag": "geosite-steamcn", "type": "remote", "format": "binary", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/steam@cn.srs"},
      {"tag": "geosite-steam", "type": "remote", "format": "binary", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/steam.srs"},
      {"tag": "Epic_domain", "type": "remote", "format": "binary", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/epicgames.srs"},

