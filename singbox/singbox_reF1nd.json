{
  "$schema": "https://raw.githubusercontent.com/reF1nd/sing-box/reF1nd-testing-next/docs/schema.json",
  "log": {
    "disabled": true,
    "level": "warn",
    "output": "sing-box.log",
    "timestamp": true
  },
  "providers": [
    {
      "tag": "Provider1",
      "type": "remote",
      "url": "url",
      "http_client": "s-download",
      "exclude": "节点|剩余|套餐|客服|官网",
      "path": "./source/Provider1.json",
      "update_interval": "24h",
      "health_check": {"enabled":true,"url":"http://cp.cloudflare.com/generate_204","interval":"30m","timeout":"3s"}
    }
  ],
  "http_clients": [
    {
      "tag": "s-download",
      "headers": {
        "User-Agent": "clash.meta/mihomo/alpha"
      },
      "detour": "🎯 Direct"
    }
  ],
  "dns": {
    "servers": [
      {
        "tag": "dns-proxy",
        "type": "group",
        "servers": [
          "cloudflare",
          "google"
        ]
      },
      {
        "tag": "dns-direct",
        "type": "group",
        "servers": [
          "ali",
          "tencent"
        ]
      },
      {"tag": "fakeip", "type": "fakeip", "inet4_range": "198.19.0.0/16"},
      {
        "type": "hosts",
        "tag": "hosts",
        "predefined": {
          "doh.pub": [
            "120.53.53.53",
            "1.12.12.12"
          ],
          "cloudflare-dns.com": [
            "1.1.1.1",
            "1.0.0.1"
          ],
          "dns.google": [
            "8.8.8.8",
            "8.8.4.4"
          ],
          "dns.alidns.com": [
            "223.5.5.5",
            "223.6.6.6"
          ]
        }
      },
      {
        "tag": "cloudflare",
        "type": "https",
        "server": "cloudflare-dns.com",
        "domain_resolver": "hosts",
        "detour": "🪁 Nodes"
      },
      {
        "tag": "google",
        "type": "https",
        "server": "dns.google",
        "domain_resolver": "hosts",
        "detour": "🪁 Nodes"
      },
      {
        "tag": "ali",
        "type": "https",
        "server": "dns.alidns.com",
        "domain_resolver": "hosts"
      },
      {
        "tag": "tencent",
        "type": "https",
        "server": "doh.pub",
        "domain_resolver": "hosts"
      }
    ],
    "rules": [
      {"query_type": ["HTTPS", "SVCB"], "action": "reject"},
      {"clash_mode": "Direct", "action": "route", "server": "dns-direct" },
      {"clash_mode": "Global", "action": "route", "server": "fakeip" },

      {"rule_set": ["fakeip-filter-cn", "geosite-cn", "geosite-steamcn", "apple_cdn", "apple_cn_non_ip", "domestic_non_ip", "lan_non_ip", "direct_non_ip"], "server": "dns-direct"},
      
      {"rule_set": "fakeip-filter-!cn", "server": "dns-proxy"},
      
      {"query_type": ["A", "AAAA"], "server": "fakeip", "rewrite_ttl": 1}
    ],
    "final": "dns-proxy",
    "optimistic": true,
    "strategy": "prefer_ipv4",
    "cache_capacity": 4096,
    "reverse_mapping": true
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "0.0.0.0",
      "listen_port": 7890
    },
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "auto_redirect": true
    }
  ],
  "route": {
    "rules": [
      {"type": "logical", "mode": "and", "rules": [{"port": [53, 853], "invert": true}, {"clash_mode": "Global", "invert": true}, {"type": "logical", "mode": "or", "rules": [{"ip_is_private": true}, {"rule_set": "geoip-cn"}]}], "action": "bypass"},
      
      {"type": "logical", "mode": "or", "rules": [{"domain_suffix": "push.apple.com"}, {"rule_set": "telegram_ip"}], "invert": true, "action": "sniff", "sniffer": ["http", "tls", "stun", "quic", "dns"], "timeout": "100ms"},
      {"type": "logical", "mode": "or", "rules": [{"port": 53}, {"protocol": "dns"}], "action": "hijack-dns"},

      {"ip_is_private": true, "outbound": "🎯 Direct"},
      {"clash_mode": "direct", "outbound": "🎯 Direct"},
      {"clash_mode": "global", "outbound": "GLOBAL"},

      {"rule_set": ["amend_direct"], "outbound": "🎯 Direct"},
      {"rule_set": ["reject_non_ip_drop"], "action": "reject", "method": "drop"},
      {"rule_set": ["reject_non_ip", "reject_domainset"], "action": "route", "outbound": "🛑 AdBlock"},
      {"rule_set": ["reject_non_ip_no_drop"], "action": "reject", "no_drop": true},
      
      {"rule_set": ["cdn_domainset", "cdn_non_ip"], "outbound": "🪁 Nodes"},
      {"rule_set": ["Spotify_domain"], "outbound": "🎼 Spotify"},
      {"rule_set": ["stream_hk_non_ip"], "outbound": "📹 HK&TW Media"},
      {"rule_set": ["stream_tw_non_ip"], "outbound": "📹 HK&TW Media"},
      {"rule_set": ["stream_us_non_ip"], "outbound": "🇺🇸 USA"},
      {"rule_set": ["stream_jp_non_ip"], "outbound": "🇯🇵 Japan"},
      {"rule_set": ["stream_kr_non_ip"], "outbound": "🇰🇷 Korea"},
      {"rule_set": ["stream_eu_non_ip"], "outbound": "🇪🇺 Europe"},
      {"rule_set": ["stream_non_ip"], "outbound": "📹 Global Media"},
      {"rule_set": ["SNTP"], "outbound": "🎥 Emby"},
      {"rule_set": ["ai_non_ip"], "outbound": "🤖 AIGC"},
      {"rule_set": ["telegram_non_ip"], "outbound": "💬 Telegram"},
      {"rule_set": ["geosite-steamcn"], "outbound": "🎯 Direct"},
      {"rule_set": ["geosite-steam", "Epic_domain"], "outbound": "🎮 Gaming"},
      {"rule_set": ["download_domainset", "download_non_ip"], "outbound": "💾 Download"},
      {"rule_set": ["apple_cdn","apple_cn_non_ip"], "outbound": "🎯 Direct"},
      {"rule_set": ["microsoft_cdn_non_ip"], "outbound": "💾 Microsoft"},
      {"rule_set": ["apple_services"], "outbound": "🍎 Apple"},
      {"rule_set": ["microsoft_non_ip"], "outbound": "💾 Microsoft"},
      {"rule_set": ["global_non_ip"], "outbound": "🪁 Nodes"},
      {"rule_set": ["geosite-!cn"], "outbound": "🪁 Nodes"},
      {"rule_set": ["WeChat_domain"], "outbound": "🎯 Direct"},
      {"rule_set": ["domestic_non_ip", "lan_non_ip", "direct_non_ip"], "outbound": "🎯 Direct"},
      {
        "action": "resolve",
        "match_only": true
      },
      {"rule_set": ["reject_ip"], "action": "route", "outbound": "🛑 AdBlock"},
      {"rule_set": ["telegram_ip"], "outbound": "💬 Telegram"},
      {"rule_set": ["stream_hk_ip"], "outbound": "📹 HK&TW Media"},
      {"rule_set": ["stream_tw_ip"], "outbound": "📹 HK&TW Media"},
      {"rule_set": ["stream_us_ip"], "outbound": "🇺🇸 USA"},
      {"rule_set": ["stream_jp_ip"], "outbound": "🇯🇵 Japan"},
      {"rule_set": ["stream_kr_ip"], "outbound": "🇰🇷 Korea"},
      {"rule_set": ["stream_eu_ip"], "outbound": "🇪🇺 Europe"},
      {"rule_set": ["stream_ip"], "outbound": "📹 Global Media"},

      {"rule_set": ["lan_ip", "domestic_ip", "china_ip"], "outbound": "🎯 Direct"},
      {"rule_set": ["geosite-cn", "geoip-cn"], "outbound": "🎯 Direct"}
    ],

    "rule_set": [
      {"tag": ["fakeip-filter-cn", "fakeip-filter-!cn"], "type": "remote", "format": "source", "url": "https://gh-proxy.org/https://raw.githubusercontent.com/Boringahhh/ssrclash/new/singbox/config/{tag}.json"},

      {"tag": "amend_direct", "type": "remote", "format": "source", "url": "https://gh-proxy.org/https://raw.githubusercontent.com/Boringahhh/ssrclash/new/singbox/config/Direct.json"},

      {"tag": "reject_non_ip_no_drop", "type": "remote", "format": "source", "url": "https://ruleset.skk.moe/sing-box/non_ip/reject-no-drop.json"},
      {"tag": "reject_non_ip_drop", "type": "remote", "format": "source", "url": "https://ruleset.skk.moe/sing-box/non_ip/reject-drop.json"},
      {"tag": "reject_non_ip", "type": "remote", "format": "source", "url": "https://ruleset.skk.moe/sing-box/non_ip/reject.json"},
      {"tag": "reject_domainset", "type": "remote", "format": "source", "url": "https://ruleset.skk.moe/sing-box/domainset/reject.json"},
      {"tag": "reject_ip", "type": "remote", "format": "source", "url": "https://ruleset.skk.moe/sing-box/ip/reject.json"},
      
      {"tag": "cdn_domainset", "type": "remote", "format": "source", "url": "https://ruleset.skk.moe/sing-box/domainset/cdn.json"},
      {"tag": "cdn_non_ip", "type": "remote", "format": "source", "url": "https://ruleset.skk.moe/sing-box/non_ip/cdn.json"},
      
      {"tag": "Spotify_domain", "type": "remote", "format": "binary", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/spotify.srs"},

      {"tag": "stream_us_non_ip", "type": "remote", "format": "source", "url": "https://ruleset.skk.moe/sing-box/non_ip/stream_us.json"},
      {"tag": "stream_us_ip", "type": "remote", "format": "source", "url": "https://ruleset.skk.moe/sing-box/ip/stream_us.json"},
      {"tag": "stream_eu_non_ip", "type": "remote", "format": "source", "url": "https://ruleset.skk.moe/sing-box/non_ip/stream_eu.json"},
      {"tag": "stream_eu_ip", "type": "remote", "format": "source", "url": "https://ruleset.skk.moe/sing-box/ip/stream_eu.json"},
